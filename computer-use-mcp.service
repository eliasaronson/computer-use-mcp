[Unit]
Description=Computer-use MCP server for Claude Code (sway)

[Service]
# grim; set here because the unit can start before sway exports PATH
Environment=PATH=/run/current-system/sw/bin:/etc/profiles/per-user/%u/bin:%h/.nix-profile/bin:/usr/bin:/bin
ExecStart=%h/Documents/computer_use/rust/target/release/computer-use-mcp
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/state/computer-use-mcp
UMask=0077
MemoryMax=256M

[Install]
WantedBy=default.target
